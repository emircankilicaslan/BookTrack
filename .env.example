# docker compose için: kopyalayıp .env yapın; .env asla commit edilmez.
# İmza anahtarı (en az 32 karakter rastgele):  openssl rand -base64 48
JWT_SECRET=
# İlk yönetici: veritabanında aktif Admin yoksa açılışta oluşturulur (parola en az 8 karakter).
ADMIN_USERNAME=yonetici
ADMIN_PASSWORD=
# SQL Server sa parolası (karmaşıklık kuralları: büyük/küçük harf, rakam, sembol; en az 8 karakter).
# Boş bırakılırsa docker-compose.yml içindeki yerel deneme değeri kullanılır.
MSSQL_SA_PASSWORD=
